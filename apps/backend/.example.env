SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_KEY=...
OPENAI_API_KEY=...
ANTHROPIC_API_KEY=...
GROQ_API_KEY=

# LLM_PROVIDER options: anthropic, groq (cheap)
LLM_PROVIDER=anthropic
# LLM_MODEL is optional; leave empty to use the provider's default.
# anthropic options: claude-sonnet-4-6, claude-opus-4-8, claude-haiku-4-5
# groq options: llama-3.3-70b-versatile, llama-3.1-8b-instant
LLM_MODEL=
PORT=8000
admin_api_key=...